<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">shop.order.form</field>
        <field name="model">shop.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" groups="shop.group_shop_manager" invisible="state != 'draft'"/>
                </header>
                <field name="name"/>
                <field name="partner_city"/>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="qty"/>
                        <field name="price"/>
                        <field name="subtotal"/>
                    </tree>
                </field>
                <field name="amount_total"/>
            </form>
        </field>
    </record>
    <record id="view_order_tree" model="ir.ui.view">
        <field name="name">shop.order.tree</field>
        <field name="model">shop.order</field>
        <field name="arch" type="xml">
            <tree><field name="name"/><field name="amount_total"/></tree>
        </field>
    </record>
    <record id="action_orders" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">shop.order</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_root" name="Shop">
        <menuitem id="menu_orders" name="Orders" action="action_orders" groups="group_shop_user"/>
    </menuitem>
</odoo>
